    private List<string> PreviewTagNames => tags?.Where(t => selectedTagIds.Contains(t.Id)).Select(t => t.Name).ToList() ?? new();

    private void OpenPreview() => showPreview = true;
    private void ClosePreview() => showPreview = false;

    private string FormatAutosaveTime()
    {
        if (lastAutosaveAt is null) return "";
        var seconds = (int)(DateTime.Now - lastAutosaveAt.Value).TotalSeconds;
        return seconds < 5 ? "just now" : $"{seconds}s ago";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;
        _currentUsername = username ?? "admin";
        var role = await UserService.GetUserRoleAsync(username);
        if (!await PermissionService.IsAllowedAsync(role, Permissions.ArticlesManage))
        {
            Nav.NavigateTo("/admin/articles");
            return;
        }

        categories = await ArticleService.GetCategoriesAsync(true);
        tags = await ArticleService.GetAllTagsAsync();

        if (Id is not null)
        {
            await LoadArticle();
