@page "/admin/articles/new"
@page "/admin/articles/{Id:int}/edit"
@layout FaqCms.Components.Layout.AdminLayout
@attribute [Authorize]
@implements IDisposable
@inject ArticleService ArticleService
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject UserService UserService
@inject PermissionService PermissionService
@inject ILogger<ArticleEdit> Logger

@if (categories is null || tags is null)
{
    <p class="ed-loading">Loading…</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="Save" OnInvalidSubmit="OnInvalidSubmit">
        <DataAnnotationsValidator />

        <div class="ed-head">
            <div class="ed-titles">
                <p class="crumb">
                    Articles
                    @if (PreviewCategoryName != "(no category)")
                    {
                        <text> / @PreviewCategoryName</text>
                    }
                    / <b>@(string.IsNullOrWhiteSpace(model.Title) ? (Id is null ? "New article" : "Untitled") : model.Title)</b>
                </p>
                <h2>@(Id is null ? "New article" : "Edit article")</h2>
            </div>

            @if (lastAutosaveAt is not null)
            {
                <span class="ed-saved" title="Autosaves as a Draft every 20s — Cancel undoes it, Save article makes it permanent.">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                    Draft saved @FormatAutosaveTime()
                </span>
            }

            <div class="ed-actions">
                @if (Id is not null)
                {
                    <button type="button" class="btn-secondary ed-quiet" title="Version history" @onclick="ShowVersions">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        History
                    </button>
                }
                <button type="button" class="btn-secondary" @onclick="OpenPreview">Preview</button>
                <button type="button" class="btn-secondary ed-hide-narrow" @onclick="CancelEdit">Cancel</button>
                <button type="submit" class="btn-primary ed-hide-narrow" disabled="@IsUploading">Save article</button>
            </div>
        </div>

        @if (showValidationBanner)
        {
            <p class="field-warning ed-banner" role="alert">
                This article can't be saved yet — the required fields marked
                <span class="required-mark">*</span> below still need filling in.
            </p>
        }

        @if (concurrentEditDetected)
        {
            <p class="field-warning ed-banner" role="alert">
                This article was saved somewhere else since you opened it — another tab, another
                admin, or a browser window you closed without saving. Autosaving has been paused so
                those changes aren't overwritten. <strong>Save article</strong> still works and will
                replace them with what's on this page; open the article fresh in a new tab first if
                you'd rather check what changed.
            </p>
        }

        @if (!string.IsNullOrEmpty(uploadError))
        {
            <p class="field-warning ed-banner" role="alert">
                @uploadError
                <button type="button" class="link-danger" @onclick="() => uploadError = null">Dismiss</button>
            </p>
        }
        @if (IsUploading)
        {
            <p class="helper-text ed-banner">Waiting for a photo or video upload to finish before this can be saved…</p>
        }

        <div class="ed-body">

            <div class="ed-main">

                <section class="ed-card">
                    <header><h3>Article</h3><span class="ed-card-hint">Shown in search and article lists</span></header>
                    <div class="ed-card-body">
                        <div class="field">
                            <span>Title <span class="required-mark" title="Required">*</span></span>
                            <InputText @bind-Value="model.Title" class="ed-title-input" />
                            <ValidationMessage For="() => model.Title" class="field-error" />
                        </div>

                        <div class="field">
                            <span>Summary <span class="required-mark" title="Required">*</span></span>
                            <InputTextArea @bind-Value="model.Summary" rows="3" placeholder="One or two sentences describing what this article covers." />
                            <ValidationMessage For="() => model.Summary" class="field-error" />
                        </div>

                        <div class="field">
                            <span>Link address</span>
                            <InputText @bind-Value="model.Slug" placeholder="auto-generated from title" />
                            <span class="field-hint">Leave blank and we'll build it from the title.</span>
                        </div>
                    </div>
                </section>

                <section class="ed-card">
                    <header><h3>Video</h3><span class="ed-card-hint">Optional</span></header>
                    <div class="ed-card-body">
                        <div class="ed-videobox">
                            @if (!string.IsNullOrWhiteSpace(model.VideoUrl))
                            {
                                <div class="media-preview ed-video-preview">
                                    @if (VideoEmbedHelper.IsUploadedFile(model.VideoUrl))
                                    {
                                        <video src="@model.VideoUrl" controls></video>
                                    }
                                    else
                                    {
                                        <iframe src="@VideoEmbedHelper.ToEmbedUrl(model.VideoUrl)" class="media-preview-frame" allowfullscreen></iframe>
                                    }
                                </div>
                            }
                            <div class="field ed-video-field">
                                <span>Embed link</span>
                                <InputText @bind-Value="model.VideoUrl" placeholder="Paste an embed URL (e.g. YouTube) — or upload a file below" />
                                <span class="field-hint">
                                    YouTube: any watch/share link works. SharePoint/OneDrive: use the file's own
                                    <strong>Embed</strong> link (Share → Embed → copy the URL out of the &lt;iframe&gt; code) —
                                    a plain "Copy link" share link won't play here.
                                </span>
                                @if (!string.IsNullOrWhiteSpace(model.VideoUrl) && VideoEmbedHelper.IsLikelySharePointShareLink(model.VideoUrl))
                                {
                                    <p class="field-warning">This looks like a SharePoint "share" link rather than an "Embed" link — it may show blank. See the hint above.</p>
                                }
                                <div class="media-upload-row">
                                    <InputFile OnChange="OnArticleVideoSelected" accept="video/*" />
                                    @if (articleVideoUploading) { <span class="upload-status">Uploading…</span> }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(model.VideoUrl))
                                {
                                    <button type="button" class="link-danger" @onclick="() => model.VideoUrl = string.Empty">Remove video</button>
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <section class="ed-card">
                    <header>
                        <h3>Steps</h3>
                        <span class="ed-card-hint">
                            @steps.Count step@(steps.Count == 1 ? "" : "s")
                            @if (TotalStepMinutes is not null) { <text> · about @TotalStepMinutes min</text> }
                        </span>
                    </header>
                    <div class="ed-card-body">
                        <div class="ed-steps">
                            @for (var i = 0; i < steps.Count; i++)
                            {
                                var idx = i;
                                var step = steps[idx];
                                var key = stepKeys[idx];
                                <details class="ed-step" @key="key" open="@openStepKeys.Contains(key)">
                                    <summary class="ed-step-head">
                                        <span class="ed-step-num">@(idx + 1)</span>
                                        <span class="ed-step-name @(string.IsNullOrWhiteSpace(step.Title) ? "ed-step-name-empty" : "")">
                                            @(string.IsNullOrWhiteSpace(step.Title) ? "Untitled step" : step.Title)
                                        </span>
                                        <span class="ed-step-badges">
                                            @if (!string.IsNullOrWhiteSpace(step.ImageUrl))
                                            {
                                                <span class="ed-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 16l-5-5-6 6"/></svg>photo</span>
                                            }
                                            @if (step.EstimatedMinutes is not null)
                                            {
                                                <span class="ed-chip">@(step.EstimatedMinutes) min</span>
                                            }
                                            @if (step.IsOptional)
                                            {
                                                <span class="ed-chip">optional</span>
                                            }
                                        </span>
                                        <span class="ed-step-move">
                                            <button type="button" class="ed-move-btn" title="Move up" disabled="@(idx == 0)" @onclick="() => MoveStepUp(idx)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 15l6-6 6 6"/></svg>
                                            </button>
                                            <button type="button" class="ed-move-btn" title="Move down" disabled="@(idx == steps.Count - 1)" @onclick="() => MoveStepDown(idx)" @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                                            </button>
                                        </span>
                                        <span class="ed-step-caret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span>
                                    </summary>

                                    <div class="ed-step-panel">
                                        <div class="field">
                                            <span>Step title</span>
                                            <input placeholder="e.g. Go to Transactions" value="@step.Title"
                                                   @oninput="e => step.Title = e.Value?.ToString() ?? string.Empty" />
                                        </div>
                                        <div class="field">
                                            <span>What the person does</span>
                                            <textarea rows="2" placeholder="e.g. Click Overtime, then fill in the hours worked."
                                                      @oninput="e => step.Description = e.Value?.ToString() ?? string.Empty">@step.Description</textarea>
                                        </div>

                                        <div class="ed-step-media">
                                            @if (!string.IsNullOrWhiteSpace(step.ImageUrl))
                                            {
                                                <span class="step-photo-preview ed-shot">
                                                    <img src="@step.ImageUrl" alt="Step @(idx + 1) photo" onerror="this.classList.add('img-broken')" />
                                                    <span class="img-broken-fallback">Photo failed to load — try removing and re-uploading it.</span>
                                                </span>
                                            }
                                            else if (stepUploading.Contains(idx))
                                            {
                                                <span class="ed-shot ed-shot-uploading">Uploading…</span>
                                            }
                                            else
                                            {
                                                <label class="ed-shot ed-shot-empty">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M20 16v3a2 2 0 01-2 2H6a2 2 0 01-2-2v-3"/></svg>
                                                    <span>Add a photo</span>
                                                    <InputFile OnChange="e => OnStepImageSelected(e, idx)" accept="image/*" />
                                                </label>
                                            }

                                            <div class="ed-step-media-fields">
                                                <div class="field">
                                                    <span>Photo description</span>
                                                    <InputText placeholder="Describes the photo, for screen readers" @bind-Value="step.ImageAlt" />
                                                </div>
                                                <div class="ed-mini-row">
                                                    <div class="field ed-minutes-field">
                                                        <span>Minutes</span>
                                                        <InputNumber placeholder="e.g. 2" @bind-Value="step.EstimatedMinutes" />
                                                    </div>
                                                    <label class="checkbox-inline">
                                                        <input type="checkbox" @bind="step.IsOptional" />
                                                        <span>Optional step</span>
                                                    </label>
                                                </div>
                                                <div class="ed-step-foot">
                                                    @if (!string.IsNullOrWhiteSpace(step.ImageUrl))
                                                    {
                                                        <label class="btn-secondary ed-replace-photo">
                                                            Replace photo
                                                            <InputFile OnChange="e => OnStepImageSelected(e, idx)" accept="image/*" />
                                                        </label>
                                                        <button type="button" class="link-danger" @onclick="() => step.ImageUrl = null">Remove photo</button>
                                                    }
                                                    <button type="button" class="link-danger" @onclick="() => RemoveStep(idx)">Remove step</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </details>
                            }
                        </div>
                        <button type="button" class="ed-addstep" @onclick="AddStep">+ Add step</button>
                    </div>
                </section>

            </div>

            <aside class="ed-rail">

                <details class="ed-card" open>
                    <summary><h3>Publishing</h3><span class="ed-foldcaret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span></summary>
                    <div class="ed-card-body">
                        <label class="ed-switch-row">
                            <span>
                                <span class="ed-switch-lab">Published</span>
                                <span class="ed-switch-sub">Visible on the helpdesk</span>
                            </span>
                            <span class="ed-switch"><input type="checkbox" @bind="model.IsPublished" /><i></i></span>
                        </label>
                        <label class="ed-switch-row">
                            <span>
                                <span class="ed-switch-lab">Featured</span>
                                <span class="ed-switch-sub">Pinned on the home page</span>
                            </span>
                            <span class="ed-switch"><input type="checkbox" @bind="model.IsFeatured" /><i></i></span>
                        </label>
                        <div class="field">
                            <span>Go live on</span>
                            <InputDate @bind-Value="model.ScheduledPublishAt" class="date-input" />
                            <span class="field-hint">Leave empty to publish immediately when "Published" is checked.</span>
                        </div>
                        @if (Id is not null)
                        {
                            <p class="ed-pub-state">
                                <span class="ed-dot @(originalIsPublished == true ? "" : "ed-dot-draft")"></span>
                                @(originalIsPublished == true ? "Published" : "Draft")
                                @if (lastKnownUpdatedAt is not null)
                                {
                                    <text> · saved @lastKnownUpdatedAt.Value.ToLocalTime().ToString("MMM d, HH:mm")</text>
                                }
                            </p>
                        }
                    </div>
                </details>

                <details class="ed-card" open>
                    <summary><h3>Placement</h3><span class="ed-foldcaret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span></summary>
                    <div class="ed-card-body">
                        <div class="field">
                            <span>Category</span>
                            <select @bind="selectedTopCategoryId" @bind:after="OnTopCategoryBindChanged">
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>

                        @if (CurrentSubCategories.Count > 0)
                        {
                            <div class="field">
                                <span>Subcategory</span>
                                <select value="@(model.CategoryId == selectedTopCategoryId ? "" : model.CategoryId.ToString())" @onchange="OnSubCategoryChanged">
                                    <option value="">General (no subcategory)</option>
                                    @foreach (var sub in CurrentSubCategories)
                                    {
                                        <option value="@sub.Id">@sub.Name</option>
                                    }
                                </select>
                                <span class="field-hint">Keeps this out of the general "@(categories?.FirstOrDefault(c => c.Id == selectedTopCategoryId)?.Name)" list.</span>
                            </div>
                        }
                    </div>
                </details>

                <details class="ed-card" open>
                    <summary><h3>Tags</h3><span class="ed-card-hint">@selectedTagIds.Count picked</span><span class="ed-foldcaret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span></summary>
                    <div class="ed-card-body">
                        <div class="tag-selector">
                            @foreach (var tag in tags)
                            {
                                var isSelected = selectedTagIds.Contains(tag.Id);
                                <label class="tag-option @(isSelected ? "selected" : "")">
                                    <input type="checkbox" checked="@isSelected" @onchange="e => ToggleTag(tag.Id, (bool)e.Value!)" />
                                    <span class="tag-color-dot" style="--swatch-color: @tag.Color; margin-right: 6px;"></span>
                                    @tag.Name
                                </label>
                            }
                        </div>
                    </div>
                </details>

                <details class="ed-card" open>
                    <summary><h3>Related articles</h3><span class="ed-foldcaret"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span></summary>
                    <div class="ed-card-body">
                        <div class="ed-relmode">
                            <label class="@(model.RelatedArticlesMode == "manual" ? "on" : "")">
                                <input type="radio" name="relmode" checked="@(model.RelatedArticlesMode == "manual")" @onchange='() => SetRelatedMode("manual")' />
                                <span><span class="ed-relmode-t">Choose them myself</span><span class="ed-relmode-d">Only the articles you pick, in your order.</span></span>
                            </label>
                            <label class="@(model.RelatedArticlesMode == "auto" ? "on" : "")">
                                <input type="radio" name="relmode" checked="@(model.RelatedArticlesMode == "auto")" @onchange='() => SetRelatedMode("auto")' />
                                <span><span class="ed-relmode-t">Pick automatically</span><span class="ed-relmode-d">Top 5 articles sharing this article's tags.</span></span>
                            </label>
                        </div>

                        @if (model.RelatedArticlesMode == "manual")
                        {
                            <div class="ed-relpicker">
                                @if (manualRelated.Count == 0)
                                {
                                    <p class="ed-rel-empty">Nothing picked yet — search below. Leave it empty and no related-articles section shows on this article.</p>
                                }
                                else
                                {
                                    <ol class="ed-rel-chosen">
                                        @for (var i = 0; i < manualRelated.Count; i++)
                                        {
                                            var idx = i;
                                            var a = manualRelated[idx];
                                            <li @key="a.Id">
                                                <span class="ed-rel-ord">@(idx + 1)</span>
                                                <span class="ed-rel-ttl">@a.Title</span>
                                                <span class="ed-rel-move">
                                                    <button type="button" class="ed-move-btn" title="Move up" disabled="@(idx == 0)" @onclick="() => MoveRelatedUp(idx)">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 15l6-6 6 6"/></svg>
                                                    </button>
                                                    <button type="button" class="ed-move-btn" title="Move down" disabled="@(idx == manualRelated.Count - 1)" @onclick="() => MoveRelatedDown(idx)">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                                                    </button>
                                                </span>
                                                <button type="button" class="ed-rel-x" title="Remove" @onclick="() => RemoveRelated(a.Id)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
                                                </button>
                                            </li>
                                        }
                                    </ol>
                                }

                                <div class="ed-rel-search">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
                                    <input type="text" placeholder="Search published articles" value="@relatedSearchTerm" @oninput="OnRelatedSearchInput" />
                                </div>

                                @if (relatedSearchResults.Count > 0)
                                {
                                    <ul class="ed-rel-results">
                                        @foreach (var a in relatedSearchResults)
                                        {
                                            <li @key="a.Id">
                                                <label>
                                                    <input type="checkbox" checked="@manualRelated.Any(m => m.Id == a.Id)" @onchange="e => OnRelatedResultToggled(a, (bool)e.Value!)" />
                                                    <span>
                                                        <span class="ed-rel-result-t">@a.Title</span><br />
                                                        <span class="ed-rel-result-m">@(a.Category?.Name ?? "Uncategorized")@(a.IsPublished ? "" : " · Draft")</span>
                                                    </span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (!string.IsNullOrWhiteSpace(relatedSearchTerm))
                                {
                                    <p class="ed-rel-none">No article matches "@relatedSearchTerm".</p>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="ed-relpicker">
                                @if (selectedTagIds.Count == 0)
                                {
                                    <p class="ed-rel-empty">Pick a tag above first — automatic matching is based on shared tags.</p>
                                }
                                else if (autoPreview is null)
                                {
                                    <p class="ed-rel-empty">Loading preview…</p>
                                }
                                else if (autoPreview.Count == 0)
                                {
                                    <p class="ed-rel-empty">No other published article shares these tags yet.</p>
                                }
                                else
                                {
                                    <p class="ed-rel-note">Based on this article's tags, these would show today:</p>
                                    <div class="ed-rel-auto">
                                        @for (var i = 0; i < autoPreview.Count; i++)
                                        {
                                            <div><span class="ed-step-num ed-step-num-sm">@(i + 1)</span> @autoPreview[i].Title</div>
                                        }
                                    </div>
                                    <p class="ed-rel-note">This list changes automatically as tags or view counts change.</p>
                                }
                            </div>
                        }
                    </div>
                </details>

            </aside>
        </div>

        <div class="ed-mobar">
            @if (lastAutosaveAt is not null)
            {
                <span class="ed-saved"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Saved</span>
            }
            <button type="button" class="btn-secondary" @onclick="CancelEdit">Cancel</button>
            <button type="submit" class="btn-primary" disabled="@IsUploading">Save article</button>
        </div>
    </EditForm>
}

@if (showPreview)
{
    <div class="modal-overlay" @onclick="ClosePreview">
        <div class="modal-content modal-content-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Preview — not saved yet</h3>
                <button type="button" class="modal-close" @onclick="ClosePreview">&times;</button>
            </div>
            <div class="modal-body">
                <div class="preview-notice">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>This is how the article will look. Nothing has been saved — close this to keep editing.</span>
                </div>

                <div class="article-preview">
                    <p class="crumb">
                        <span class="crumb-home">Helpdesk</span>
                        <span class="sep">/</span>
                        <span class="crumb-category">@PreviewCategoryName</span>
                        <span class="sep">/</span>
                        <span class="here">@(string.IsNullOrWhiteSpace(model.Title) ? "(untitled)" : model.Title)</span>
                    </p>

                    <div class="title-row">
                        <h1>@(string.IsNullOrWhiteSpace(model.Title) ? "(untitled)" : model.Title)</h1>
                        <div class="title-meta">
                            @if (PreviewTagNames.Any())
                            {
                                <div class="tags-inline">
                                    @foreach (var tagName in PreviewTagNames)
                                    {
                                        <span class="tag">@tagName</span>
                                    }
                                </div>
                            }
                            <span class="@(model.IsPublished ? "status-badge published" : "status-badge draft")">@(model.IsPublished ? "Published" : "Draft")</span>
                        </div>
                    </div>

                    <p class="lede">@(string.IsNullOrWhiteSpace(model.Summary) ? "(no summary yet)" : model.Summary)</p>

                    @if (!string.IsNullOrWhiteSpace(model.VideoUrl))
                    {
                        <div class="demo-block">
                            <div class="demo-label">Watch: @model.Title</div>
                            <div class="video-frame">
                                @if (VideoEmbedHelper.IsUploadedFile(model.VideoUrl))
                                {
                                    <video src="@model.VideoUrl" controls class="media-fill"></video>
                                }
                                else
                                {
                                    <iframe src="@VideoEmbedHelper.ToEmbedUrl(model.VideoUrl)" title="@model.Title" allowfullscreen class="media-fill"></iframe>
                                }
                            </div>
                        </div>
                    }

                    @if (steps.Any())
                    {
                        <ol class="steps">
                            @foreach (var step in steps)
                            {
                                <li>
                                    <div class="step-body">
                                        <h3>@(string.IsNullOrWhiteSpace(step.Title) ? "(untitled step)" : step.Title)</h3>
                                        @if (step.EstimatedMinutes.HasValue)
                                        {
                                            <span class="step-duration">~@step.EstimatedMinutes min read</span>
                                        }
                                        @if (step.IsOptional)
                                        {
                                            <span class="step-optional">Optional</span>
                                        }
                                        <p>@step.Description</p>
                                        @if (!string.IsNullOrWhiteSpace(step.ImageUrl))
                                        {
                                            <div class="step-inline-media"><img src="@step.ImageUrl" alt="@(step.ImageAlt ?? step.Title)" /></div>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }

                    @if (model.RelatedArticlesMode == "manual" && manualRelated.Count > 0)
                    {
                        <section class="related-articles">
                            <h2>Related Articles</h2>
                            <div class="related-grid">
                                @foreach (var related in manualRelated)
                                {
                                    <div class="related-card">
                                        <span class="related-category">@related.Category?.Name</span>
                                        <h3>@related.Title</h3>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-primary" @onclick="ClosePreview">← Back to editing</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showVersions && versions is not null)
{
    <div class="modal-overlay" @onclick="CloseVersions">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Version History</h3>
                <button type="button" class="modal-close" @onclick="CloseVersions">&times;</button>
            </div>
            <div class="modal-body">
                @foreach (var v in versions)
                {
                    <div class="version-item">
                        <div class="version-info">
                            <span class="version-number">v@(v.VersionNumber)</span>
                            <span class="version-title">@v.Title</span>
                            <span class="version-date">@v.CreatedAt.ToString("MMM d, yyyy HH:mm") by @v.CreatedBy</span>
                            <span class="version-notes">@v.ChangeNotes</span>
                        </div>
                        <button type="button" class="btn-secondary" @onclick="() => RestoreVersion(v.Id)">Restore</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private const long MaxUploadBytes = 200 * 1024 * 1024; // 200 MB
    private const int MaxImageDimension = 1600; // px, longest side — plenty for a help-article screenshot

    private List<Category>? categories;
    private int selectedTopCategoryId;
    private List<Category> CurrentSubCategories =>
        categories?.FirstOrDefault(c => c.Id == selectedTopCategoryId)?.SubCategories.OrderBy(s => s.SortOrder).ToList() ?? new();

    /// <summary>Figures out which top-level category is selected from model.CategoryId,
    /// which may itself already be a subcategory (when editing an existing article).</summary>
    private void SyncSelectedTopCategory()
    {
        if (categories is null) return;
        var match = categories.FirstOrDefault(c => c.Id == model.CategoryId)
                 ?? categories.SelectMany(c => c.SubCategories).FirstOrDefault(c => c.Id == model.CategoryId);
        selectedTopCategoryId = match?.ParentCategoryId ?? match?.Id ?? model.CategoryId;
