    private void OnRelatedResultToggled(Article article, bool selected)
    {
        if (selected)
        {
            if (!manualRelated.Any(m => m.Id == article.Id))
                manualRelated.Add(article);
        }
        else
        {
            manualRelated.RemoveAll(m => m.Id == article.Id);
        }
    }

    private void RemoveRelated(int articleId) => manualRelated.RemoveAll(m => m.Id == articleId);

    private void MoveRelatedUp(int index)
    {
        if (index <= 0) return;
        (manualRelated[index - 1], manualRelated[index]) = (manualRelated[index], manualRelated[index - 1]);
    }

    private void MoveRelatedDown(int index)
    {
        if (index >= manualRelated.Count - 1) return;
        (manualRelated[index + 1], manualRelated[index]) = (manualRelated[index], manualRelated[index + 1]);
    }

    private async Task OnArticleVideoSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        var file = e.File;
        try
        {
            // Read the browser file into memory BEFORE flipping any state that
            // triggers a re-render. See the comment in OnStepImageSelected below
            // for why this ordering matters.
            using var buffered = new MemoryStream();
            await using (var readStream = file.OpenReadStream(MaxUploadBytes))
            {
                await readStream.CopyToAsync(buffered);
            }
            buffered.Position = 0;

            articleVideoUploading = true;
            StateHasChanged();

            model.VideoUrl = await SaveUploadAsync(buffered, file.ContentType, file.Name, "articles");
        }
        catch (InvalidOperationException ex)
        {
            // A rejected file type — expected, actionable, and safe to show verbatim.
            uploadError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Article video upload failed for {FileName} ({ContentType}, {Size} bytes).",
                file.Name, file.ContentType, file.Size);
            uploadError = $"\"{file.Name}\" couldn't be uploaded. Try a different file, or check the server log for details.";
        }
        finally
        {
            articleVideoUploading = false;
        }
    }

    private async Task OnStepImageSelected(InputFileChangeEventArgs e, int index)
    {
        uploadError = null;
        var file = e.File;
        try
        {
            // Read the browser file into memory BEFORE calling StateHasChanged().
            // The "Add a photo" markup swaps its <InputFile> out for an "Uploading…"
            // span as soon as stepUploading.Contains(idx) is true, which unmounts
            // the InputFile and clears the browser-side file reference Blazor needs
            // to service OpenReadStream(). Read the bytes first, while the input is
            // still mounted, and only then flip the uploading flag/state.
            using var buffered = new MemoryStream();
            await using (var readStream = file.OpenReadStream(MaxUploadBytes))
            {
                await readStream.CopyToAsync(buffered);
            }
            buffered.Position = 0;

            stepUploading.Add(index);
            StateHasChanged();

            steps[index].ImageUrl = await SaveUploadAsync(buffered, file.ContentType, file.Name, "steps");
        }
        catch (InvalidOperationException ex)
        {
            // A rejected file type — expected, actionable, and safe to show verbatim.
            uploadError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Step photo upload failed for step {Index}, file {FileName} ({ContentType}, {Size} bytes).",
                index, file.Name, file.ContentType, file.Size);
            uploadError = $"\"{file.Name}\" couldn't be uploaded. Try a different file, or check the server log for details.";
        }
        finally
        {
            stepUploading.Remove(index);
        }
    }

    /// <summary>Saves an already-buffered upload. Images are downsized and re-encoded as WebP
    /// first (see SaveCompressedImageAsync) — the actual fix for step photos taking a long time
    /// to load, since the raw phone/screenshot files people upload are routinely 1-2 MB+.
    /// Video is saved as-is; re-encoding video server-side isn't worth the CPU/complexity here.
    /// Takes a buffered MemoryStream rather than IBrowserFile because by the time this runs the
    /// UI may already have re-rendered (upload spinner, etc.) and the browser-side file the
    /// IBrowserFile points at can no longer be read — see the callers for details.</summary>
    /// <summary>Extensions a non-image upload (currently: article "video") is allowed to be
    /// saved with. Without this whitelist, the only server-side check was "is the browser's
    /// reported content-type an image?" — anything else (including a mislabeled or malicious
    /// file with a .html, .js, .aspx, .exe, etc. name) was written straight into wwwroot/uploads
    /// under whatever extension the original filename had, and served back out as a static file.
    /// This is admin-only (requires Articles.Manage), so the risk is a compromised/malicious
    /// editor account rather than an anonymous visitor, but it costs nothing to close it off.</summary>
    private static readonly HashSet<string> AllowedVideoExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".mp4", ".webm", ".ogg", ".ogv", ".mov", ".m4v"
    };

    private async Task<string> SaveUploadAsync(MemoryStream buffered, string contentType, string originalFileName, string subfolder)
    {
        var folder = Path.Combine(Env.WebRootPath, "uploads", subfolder);
        Directory.CreateDirectory(folder);

        if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return await SaveCompressedImageAsync(buffered, originalFileName, folder, subfolder);
        }

        var extension = Path.GetExtension(originalFileName);
        var isVideoContentType = contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
        var isVideoExtension = !string.IsNullOrEmpty(extension) && AllowedVideoExtensions.Contains(extension);
        if (!isVideoContentType && !isVideoExtension)
        {
            throw new InvalidOperationException(
                $"\"{originalFileName}\" isn't a supported image or video file (content-type: \"{contentType}\"). " +
                "Only image and video files can be uploaded here.");
        }

        // Normalize to a known-safe extension even when only the content-type matched,
        // so a file can never be written out with an arbitrary/dangerous extension.
        var safeExtension = isVideoExtension ? extension : ".mp4";
        var fileName = $"{Guid.NewGuid()}{safeExtension}";
        var fullPath = Path.Combine(folder, fileName);

        await using var writeStream = new FileStream(fullPath, FileMode.Create);
        await buffered.CopyToAsync(writeStream);

        return $"/uploads/{subfolder}/{fileName}";
    }

    private async Task<string> SaveCompressedImageAsync(MemoryStream buffered, string originalFileName, string folder, string subfolder)
    {
        using var original = SkiaSharp.SKBitmap.Decode(buffered);

        if (original is null)
        {
            buffered.Position = 0;
            var fallbackName = $"{Guid.NewGuid()}{Path.GetExtension(originalFileName)}";
            await using var fallbackWrite = new FileStream(Path.Combine(folder, fallbackName), FileMode.Create);
            await buffered.CopyToAsync(fallbackWrite);
            return $"/uploads/{subfolder}/{fallbackName}";
        }

        var longestSide = Math.Max(original.Width, original.Height);
        var scale = longestSide > MaxImageDimension ? (double)MaxImageDimension / longestSide : 1.0;

        SkiaSharp.SKBitmap toEncode = original;
        SkiaSharp.SKBitmap? resized = null;
        if (scale < 1.0)
        {
            var newInfo = new SkiaSharp.SKImageInfo(
                Math.Max(1, (int)Math.Round(original.Width * scale)),
                Math.Max(1, (int)Math.Round(original.Height * scale)));
            resized = original.Resize(newInfo, SkiaSharp.SKFilterQuality.High);
            if (resized is not null) toEncode = resized;
        }

        try
        {
            using var image = SkiaSharp.SKImage.FromBitmap(toEncode);
            using var encodedData = image.Encode(SkiaSharp.SKEncodedImageFormat.Webp, 82);

            var fileName = $"{Guid.NewGuid()}.webp";
            var fullPath = Path.Combine(folder, fileName);
            await using var writeStream = new FileStream(fullPath, FileMode.Create);
            encodedData.SaveTo(writeStream);

            return $"/uploads/{subfolder}/{fileName}";
        }
        finally
        {
            resized?.Dispose();
        }
    }

    private async Task Save()
    {
        showValidationBanner = false;

        if (IsUploading)
        {
            uploadError = "Still uploading a photo — please wait for it to finish before saving.";
            return;
        }

        if (model.CategoryId == 0 && categories?.Any() == true)
        {
            model.CategoryId = categories.First().Id;
            selectedTopCategoryId = model.CategoryId;
        }

        if (model.CategoryId == 0)
        {
            uploadError = "Please select a category before saving.";
            return;
        }

        _autosaveCts?.Cancel();
        _explicitExit = true;

        var authState = await AuthState.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name ?? "admin";

        var targetId = Id ?? autosavedId;

        var article = new Article
        {
            Id = targetId ?? 0,
            Title = model.Title,
            Slug = string.IsNullOrWhiteSpace(model.Slug) ? GenerateSlug(model.Title) : model.Slug,
            Summary = model.Summary,
            VideoUrl = string.IsNullOrWhiteSpace(model.VideoUrl) ? null : model.VideoUrl,
            CategoryId = model.CategoryId,
            MetaTitle = model.MetaTitle,
            MetaDescription = model.MetaDescription,
            IsPublished = model.IsPublished,
            IsFeatured = model.IsFeatured,
            ScheduledPublishAt = model.ScheduledPublishAt
        };

        int savedId;
        if (targetId is null)
        {
            var created = await ArticleService.CreateArticleAsync(article, username);
            savedId = created.Id;
            await ArticleService.UpdateArticleAsync(created, steps, username);
            await ArticleService.SetArticleTagsAsync(created.Id, selectedTagIds, username);
        }
        else
        {
            article.Id = targetId.Value;
            savedId = targetId.Value;
            await ArticleService.UpdateArticleAsync(article, steps, username);
            await ArticleService.SetArticleTagsAsync(article.Id, selectedTagIds, username);
        }

        await ArticleService.SetRelatedArticlesAsync(
            savedId, model.RelatedArticlesMode, manualRelated.Select(a => a.Id).ToList(), username);

        Nav.NavigateTo("/admin/articles");
    }

    /// <summary>Runs in the background for as long as this editor page is open.
    /// Every 20s, silently persists the current form as a safety-net draft, so
    /// accidentally closing the browser (or a crash, or a dropped connection)
    /// loses at most ~20 seconds of work instead of everything.
    ///
    /// This never publishes or unpublishes anything on its own: a brand-new
    /// article is autosaved as a Draft (IsPublished = false) regardless of what
    /// the checkbox currently shows, since it never existed before this editing
    /// session; an already-existing article keeps whatever published state it
    /// had when this page loaded (originalIsPublished), so a live article never
    /// flickers offline just because someone is mid-edit. Only clicking
    /// "Save article" actually applies the Published checkbox.</summary>
    private void StartAutosaveLoop()
    {
        _autosaveCts = new CancellationTokenSource();
        var token = _autosaveCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
                while (await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(AutosaveAsync);
                }
            }
            catch (OperationCanceledException) { /* page closed or explicit Save happened */ }
        }, token);
    }

    private async Task AutosaveAsync()
    {
        if (string.IsNullOrWhiteSpace(model.Title)) return; // nothing worth saving yet

        try
        {
            var targetId = Id ?? autosavedId;

            var article = new Article
            {
                Id = targetId ?? 0,
                Title = model.Title,
                Slug = string.IsNullOrWhiteSpace(model.Slug) ? GenerateSlug(model.Title) : model.Slug,
                Summary = model.Summary,
                VideoUrl = string.IsNullOrWhiteSpace(model.VideoUrl) ? null : model.VideoUrl,
                CategoryId = model.CategoryId,
                MetaTitle = model.MetaTitle,
                MetaDescription = model.MetaDescription,
                IsPublished = originalIsPublished ?? false,
                IsFeatured = model.IsFeatured,
                ScheduledPublishAt = model.ScheduledPublishAt
            };

            int savedId;
            if (targetId is null)
            {
                var created = await ArticleService.CreateArticleAsync(article, _currentUsername);
                autosavedId = created.Id;
                savedId = created.Id;
                lastKnownUpdatedAt = await ArticleService.UpdateArticleAsync(created, steps, _currentUsername, "Autosaved draft");
                await ArticleService.SetArticleTagsAsync(created.Id, selectedTagIds, _currentUsername);
            }
            else
            {
                article.Id = targetId.Value;
                savedId = targetId.Value;
                var writtenAt = await ArticleService.UpdateArticleAsync(
                    article, steps, _currentUsername, "Autosaved draft", lastKnownUpdatedAt);

                if (writtenAt is null)
                {
                    concurrentEditDetected = true;
                    _autosaveCts?.Cancel();
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                lastKnownUpdatedAt = writtenAt;
                await ArticleService.SetArticleTagsAsync(article.Id, selectedTagIds, _currentUsername);
            }

            await ArticleService.SetRelatedArticlesAsync(
                savedId, model.RelatedArticlesMode, manualRelated.Select(a => a.Id).ToList(), _currentUsername);

            lastAutosaveAt = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Best-effort background save — a transient DB hiccup shouldn't
            // interrupt someone who's actively typing.
        }
    }

    /// <summary>Cancel button: discards whatever the background autosave already wrote
    /// to the database this session, then leaves. An existing article reverts to the
    /// exact snapshot it had when the editor opened; a brand-new article that only
    /// ever existed as an autosaved draft is sent to the Recycle Bin, since there's
    /// no "original" to go back to.</summary>
    private async Task CancelEdit()
    {
        _autosaveCts?.Cancel();
        _explicitExit = true;

        var authState = await AuthState.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name ?? "admin";

        if (Id is not null && originalSnapshot is not null)
        {
            await ArticleService.RevertArticleAsync(originalSnapshot, originalSteps, originalTagIds, username);
        }
        else if (Id is null && autosavedId is not null)
        {
            await ArticleService.DeleteArticleAsync(autosavedId.Value, username);
        }

        Nav.NavigateTo("/admin/articles");
    }

    public void Dispose()
    {
        _autosaveCts?.Cancel();
        _autosaveCts?.Dispose();

        if (!_explicitExit)
        {
            FlushAndDraftOnAbandon();
        }
    }

    /// <summary>Last-chance save when the editor is torn down without Save or Cancel.
    ///
    /// The autosave loop only runs every 20 seconds, so on its own it loses everything
    /// typed since the last tick — and since steps are usually the last thing anyone
    /// fills in, "the steps are gone" was the normal outcome of closing the browser
    /// mid-edit. This flushes the current form first, and only then drops the article
    /// to Draft.</summary>
    private void FlushAndDraftOnAbandon()
    {
        var targetId = Id ?? autosavedId;

        if (targetId is null && string.IsNullOrWhiteSpace(model.Title))
            return;

        var article = new Article
        {
            Id = targetId ?? 0,
            Title = model.Title,
            Slug = string.IsNullOrWhiteSpace(model.Slug) ? GenerateSlug(model.Title) : model.Slug,
            Summary = model.Summary,
            VideoUrl = string.IsNullOrWhiteSpace(model.VideoUrl) ? null : model.VideoUrl,
            CategoryId = model.CategoryId,
            MetaTitle = model.MetaTitle,
            MetaDescription = model.MetaDescription,
            IsPublished = originalIsPublished ?? false,
            IsFeatured = model.IsFeatured,
            ScheduledPublishAt = model.ScheduledPublishAt
        };

        var stepsCopy = steps.Select(s => new ArticleStep
        {
            Title = s.Title,
            Description = s.Description,
            ImageUrl = s.ImageUrl,
            VideoUrl = s.VideoUrl,
            ImageAlt = s.ImageAlt,
            EstimatedMinutes = s.EstimatedMinutes,
            IsOptional = s.IsOptional
        }).ToList();

        var tagIds = new List<int>(selectedTagIds);
        var relatedIds = manualRelated.Select(a => a.Id).ToList();
        var relatedMode = model.RelatedArticlesMode;
        var expectedUpdatedAt = lastKnownUpdatedAt;
        var staleSession = concurrentEditDetected;

        var service = ArticleService;
        var username = _currentUsername;
        _ = Task.Run(async () =>
        {
            try
            {
                if (staleSession)
                {
                    return;
                }

                if (article.Id == 0)
                {
                    var created = await service.CreateArticleAsync(article, username);
                    await service.UpdateArticleAsync(created, stepsCopy, username,
                        "Autosaved — editor closed without Save");
                    await service.SetArticleTagsAsync(created.Id, tagIds, username);
                    await service.SetRelatedArticlesAsync(created.Id, relatedMode, relatedIds, username);
                    return;
                }

                var writtenAt = await service.UpdateArticleAsync(article, stepsCopy, username,
                    "Autosaved — editor closed without Save", expectedUpdatedAt);

                if (writtenAt is null)
                    return;

                await service.SetArticleTagsAsync(article.Id, tagIds, username);
                await service.SetRelatedArticlesAsync(article.Id, relatedMode, relatedIds, username);
                await service.SetPublishedStateAsync(article.Id, false, username,
                    "Auto-unpublished — editor closed without Save");
            }
            catch
            {
                // Best-effort safety net; nothing left to report errors to.
            }
        });
    }

    private async Task ShowVersions()
    {
        if (Id is not null)
        {
            versions = await ArticleService.GetArticleVersionsAsync(Id.Value);
            showVersions = true;
        }
    }

    private void CloseVersions()
    {
        showVersions = false;
        versions = null;
    }

    private async Task RestoreVersion(int versionId)
    {
        if (Id is not null)
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "admin";
            await ArticleService.RestoreArticleVersionAsync(Id.Value, versionId, username);
            CloseVersions();
            await LoadArticle();
        }
    }

    private async Task LoadArticle()
    {
        if (Id is not null)
        {
            var existing = await ArticleService.GetArticleAsync(Id.Value);
            if (existing is not null)
            {
                categories ??= await ArticleService.GetCategoriesAsync(true);

                model = new ArticleFormModel
                {
                    Title = existing.Title,
                    Slug = existing.Slug,
                    Summary = existing.Summary,
                    VideoUrl = existing.VideoUrl ?? "",
                    CategoryId = existing.CategoryId,
                    MetaTitle = existing.MetaTitle,
                    MetaDescription = existing.MetaDescription,
                    IsPublished = existing.IsPublished,
                    IsFeatured = existing.IsFeatured,
                    ScheduledPublishAt = existing.ScheduledPublishAt,
                    RelatedArticlesMode = existing.RelatedArticlesMode
                };
                originalIsPublished = existing.IsPublished;
                lastKnownUpdatedAt = existing.UpdatedAt;

                steps = existing.Steps
                    .OrderBy(s => s.SortOrder)
                    .Select(s => new ArticleStep
                    {
                        Title = s.Title,
                        Description = s.Description,
                        ImageUrl = s.ImageUrl,
                        VideoUrl = s.VideoUrl,
                        ImageAlt = s.ImageAlt,
                        EstimatedMinutes = s.EstimatedMinutes,
                        IsOptional = s.IsOptional
                    })
                    .ToList();
                stepKeys = steps.Select(_ => Guid.NewGuid()).ToList();
                // Loaded steps start collapsed, except when there's only one — nothing
                // to scan past, so open it straight away.
                openStepKeys = steps.Count == 1 && stepKeys.Count > 0
                    ? new HashSet<Guid> { stepKeys[0] }
                    : new HashSet<Guid>();

                selectedTagIds = existing.ArticleTags?.Select(at => at.TagId).ToList() ?? new();

                manualRelated = await ArticleService.GetManualRelatedArticlesAsync(Id.Value);
                if (model.RelatedArticlesMode == "auto")
                {
                    await RefreshAutoPreview();
                }

                originalSnapshot = new Article
                {
                    Id = existing.Id,
                    Title = existing.Title,
                    Slug = existing.Slug,
                    Summary = existing.Summary,
                    VideoUrl = existing.VideoUrl,
                    CategoryId = existing.CategoryId,
                    MetaTitle = existing.MetaTitle,
                    MetaDescription = existing.MetaDescription,
                    IsPublished = existing.IsPublished,
                    IsFeatured = existing.IsFeatured,
                    ScheduledPublishAt = existing.ScheduledPublishAt
                };
                originalSteps = steps.Select(s => new ArticleStep
                {
                    Title = s.Title,
                    Description = s.Description,
                    ImageUrl = s.ImageUrl,
                    VideoUrl = s.VideoUrl,
                    ImageAlt = s.ImageAlt,
                    EstimatedMinutes = s.EstimatedMinutes,
                    IsOptional = s.IsOptional
                }).ToList();
                originalTagIds = new List<int>(selectedTagIds);

                SyncSelectedTopCategory();
            }
        }
    }

    private static string GenerateSlug(string title)
    {
        var slug = title.ToLowerInvariant()
            .Replace(" ", "-")
            .Replace("&", "and")
            .Replace("/", "-");

        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"[^a-z0-9\-]", "");
        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"-+", "-");
        return slug.Trim('-');
    }

    private class ArticleFormModel
    {
        [Required(ErrorMessage = "Please enter a title for this article.")]
        public string Title { get; set; } = "";
        public string Slug { get; set; } = "";
        [Required(ErrorMessage = "Please write a short summary — it's what people see in the article list and in search results.")]
        public string Summary { get; set; } = "";
        public string VideoUrl { get; set; } = "";
        public string? MetaTitle { get; set; }
        public string? MetaDescription { get; set; }
        public int CategoryId { get; set; }
        public bool IsPublished { get; set; } = false;
        public bool IsFeatured { get; set; }
        public DateTime? ScheduledPublishAt { get; set; }
        public string RelatedArticlesMode { get; set; } = "auto";
    }
}
