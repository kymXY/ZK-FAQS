    }

    private List<Tag>? tags;
    private ArticleFormModel model = new();
    private List<ArticleStep> steps = new();

    // Parallel to `steps` (same length/order) — a client-only identity used purely so
    // <details open> state survives a step being moved, without needing Article.Id
    // (a brand-new step doesn't have one yet). openStepKeys tracks which steps the
    // user has expanded; membership is what drives the "open" attribute, so a step
    // keeps its open/closed state when it moves, and a re-render triggered by
    // something unrelated (autosave, typing elsewhere) never snaps it shut.
    private List<Guid> stepKeys = new();
    private HashSet<Guid> openStepKeys = new();

    private bool articleVideoUploading;
    private HashSet<int> stepUploading = new();
    private string? uploadError;
    private bool IsUploading => articleVideoUploading || stepUploading.Count > 0;
    private List<int> selectedTagIds = new();
    private bool showVersions;
    private List<ArticleVersion>? versions;
    private bool showPreview;

    private int? TotalStepMinutes
    {
        get
        {
            var minutes = steps.Where(s => s.EstimatedMinutes is not null).Sum(s => s.EstimatedMinutes!.Value);
            return minutes > 0 ? minutes : null;
        }
    }

    // ---- related articles ----
    private List<Article> manualRelated = new();
    private string relatedSearchTerm = "";
    private List<Article> relatedSearchResults = new();
    private int relatedSearchSeq; // guards against a slow keystroke's results landing after a faster later one
    private List<Article>? autoPreview;

    private bool? originalIsPublished; // null = brand-new, never-saved article
    private int? autosavedId;
    private DateTime? lastAutosaveAt;
    private bool showValidationBanner;

    private DateTime? lastKnownUpdatedAt;
    private bool concurrentEditDetected;
    private CancellationTokenSource? _autosaveCts;
    private string _currentUsername = "admin";

    private Article? originalSnapshot;
    private List<ArticleStep> originalSteps = new();
    private List<int> originalTagIds = new();

    private bool _explicitExit;

    private string PreviewCategoryName =>
