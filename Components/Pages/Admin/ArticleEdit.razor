        {
            _ = RefreshAutoPreview();
        }
    }

    private async Task RefreshAutoPreview()
    {
        autoPreview = null; // shows "Loading preview…" while this runs
        StateHasChanged();
        var excludeId = Id ?? autosavedId ?? 0;
        autoPreview = await ArticleService.PreviewAutoRelatedArticlesAsync(excludeId, selectedTagIds);
        StateHasChanged();
