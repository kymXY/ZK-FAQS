    private void OnInvalidSubmit(EditContext context)
    {
        showValidationBanner = true;
    }

    private void AddStep()
    {
        steps.Add(new ArticleStep());
        var key = Guid.NewGuid();
        stepKeys.Add(key);
        openStepKeys.Add(key); // a freshly added step is the one you're about to fill in
    }

    private void RemoveStep(int index)
    {
        steps.RemoveAt(index);
        var key = stepKeys[index];
        stepKeys.RemoveAt(index);
        openStepKeys.Remove(key);
    }

    private void MoveStepUp(int index)
    {
        if (index <= 0) return;
        (steps[index - 1], steps[index]) = (steps[index], steps[index - 1]);
        (stepKeys[index - 1], stepKeys[index]) = (stepKeys[index], stepKeys[index - 1]);
    }

    private void MoveStepDown(int index)
    {
        if (index >= steps.Count - 1) return;
        (steps[index + 1], steps[index]) = (steps[index], steps[index + 1]);
        (stepKeys[index + 1], stepKeys[index]) = (stepKeys[index], stepKeys[index + 1]);
    }

    private void ToggleTag(int tagId, bool isSelected)
    {
        if (isSelected) selectedTagIds.Add(tagId);
        else selectedTagIds.Remove(tagId);

        if (model.RelatedArticlesMode == "auto")
        {
            _ = RefreshAutoPreview();
